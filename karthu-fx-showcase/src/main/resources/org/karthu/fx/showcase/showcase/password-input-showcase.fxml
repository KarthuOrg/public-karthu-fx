<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- The password input's page in the group Form inputs. Each card is filled by its own method of the controller. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.PasswordInputShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Password Input" styleClass="showcase-page-title"/>
    <Label text="PasswordInput, a field for a secret on the form collection's shell (see the Overview): the text stays masked while you type it. Where the application allows it, an eye inside the field reveals the text to check it, the slashed eye masks it again, and leaving the field masks it too. A masked text never reaches the clipboard: copy and cut do nothing, by shortcut and context menu; revealed, the text behaves like a text field. A {} icon (or Ctrl+Space) binds the field to a variable, shown as a chip, with the eye disabled."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- States side by side -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="States" styleClass="showcase-card-title"/>
        <Label text="Each field sits in a form row. The eye shows only where revealing is allowed. Revealed, the eye is slashed on the hover background; click into the revealed field and leave it again, and it is masked. Read-only keeps the eye, bound disables it."
               styleClass="showcase-page-description" wrapText="true"/>
        <GridPane fx:id="statesGrid" hgap="12" vgap="8"/>
    </VBox>

    <!-- Beside a text field -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Beside a text field" styleClass="showcase-card-title"/>
        <Label text="A password input has the size and colours of a text field: a plain text field, JavaFX's own password field and the password input are exactly as high, also read-only and disabled."
               styleClass="showcase-page-description" wrapText="true"/>
        <GridPane fx:id="comparisonGrid" hgap="12" vgap="8"/>
    </VBox>

    <!-- Try it out -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Try it out" styleClass="showcase-card-title"/>
        <Label text="Switch the field's states on and off. Type or paste a password, reveal it with the eye (Reveal allowed), select a part and copy it with Ctrl+C or the context menu, then paste it into the text field below: masked, nothing is copied; revealed, the selection is. Bindable offers two sample variables: bind with the {} icon or Ctrl+Space, unbind with the chip's ×, Backspace or Remove binding, and the password comes back, masked."
               styleClass="showcase-page-description" wrapText="true"/>
        <FlowPane fx:id="tryOutSwitches" hgap="16" vgap="8"/>
        <VBox fx:id="tryOutContainer" spacing="8"/>
    </VBox>

</VBox>
