<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.karthu.fx.form.SearchInput?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.karthu.fx.showcase.controller.StyleShowcaseController">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="File">
                    <MenuItem text="Exit" onAction="#onExit"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About Style Showcase" onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <HBox styleClass="showcase-toolbar" alignment="CENTER_LEFT" spacing="8">
                <Label text="Component Showcase" styleClass="showcase-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- The colour scheme of every window, bound to the theme's choice -->
                <Label text="Theme"/>
                <HBox alignment="CENTER_LEFT" spacing="4">
                    <ToggleButton fx:id="lightScheme" text="Light"/>
                    <ToggleButton fx:id="darkScheme" text="Dark"/>
                    <ToggleButton fx:id="systemScheme" text="System"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <left>
        <!-- The navigation: a search, under it a tree of sections, groups and pages, styled by the showcase's own sheet.
             "No matches" lies over the tree while the search leaves no page. -->
        <VBox styleClass="showcase-sidebar" prefWidth="220" stylesheets="@showcase-navigation.css">
            <Label text="COMPONENTS" styleClass="showcase-sidebar-header"/>
            <SearchInput fx:id="navigationSearch" promptText="Search pages" styleClass="navigation-search">
                <VBox.margin>
                    <javafx.geometry.Insets right="12" bottom="8" left="12"/>
                </VBox.margin>
            </SearchInput>
            <StackPane VBox.vgrow="ALWAYS">
                <TreeView fx:id="navigationTree"/>
                <Label fx:id="noMatches" text="No matches" styleClass="navigation-no-matches"
                       StackPane.alignment="TOP_CENTER" visible="false" mouseTransparent="true"/>
            </StackPane>
        </VBox>
    </left>

    <center>
        <ScrollPane fx:id="contentScrollPane" fitToWidth="true" fitToHeight="true">
            <StackPane fx:id="contentArea" styleClass="showcase-content"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="8">
            <padding>
                <javafx.geometry.Insets top="4" right="8" bottom="4" left="8"/>
            </padding>
            <Label fx:id="statusLabel" text="Ready"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressBar fx:id="progressBar" visible="false" managed="false" prefWidth="150"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.0.0"/>
        </HBox>
    </bottom>

</BorderPane>
