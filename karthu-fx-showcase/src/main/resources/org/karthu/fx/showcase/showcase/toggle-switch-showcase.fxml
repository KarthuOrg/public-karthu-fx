<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.ToggleSwitchShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Toggle Switch" styleClass="showcase-page-title"/>
    <Label text="Toggle switches allow users to turn a single option on or off."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- Switches -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Switches" styleClass="showcase-card-title"/>
        <HBox fx:id="switchContainer" spacing="8" alignment="CENTER_LEFT"/>
    </VBox>

</VBox>
