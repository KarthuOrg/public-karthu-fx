<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.JobSchedulerShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Job Scheduler" styleClass="showcase-page-title"/>
    <Label text="An example application screen: a scheduler dashboard composed entirely from library components. Static mock — no functionality."
           styleClass="showcase-page-description" wrapText="true"/>

    <Label text="Scheduler Dashboard" styleClass="showcase-page-title"/>

    <!-- Scheduler stats strip -->
    <HBox styleClass="showcase-card" spacing="48">
        <VBox spacing="4">
            <Label text="Scheduler" styleClass="section-label"/>
            <Label text="DemoScheduler"
                   style="-fx-font-family: 'Monospaced'; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Status" styleClass="section-label"/>
            <Label text="RUNNING" styleClass="state-normal" style="-fx-font-size: 15px;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Jobs Executed" styleClass="section-label"/>
            <Label text="2 915"
                   style="-fx-font-family: 'Monospaced'; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Running Since" styleClass="section-label"/>
            <Label text="2026-07-16 13:19:18"
                   style="-fx-font-family: 'Monospaced'; -fx-font-size: 15px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Job toolbar -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <HBox styleClass="text-field" alignment="CENTER_LEFT" spacing="6" prefWidth="260"
              style="-fx-padding: 4 8;">
            <FontIcon iconLiteral="bi-search" iconSize="13" styleClass="icon-muted"/>
            <TextField promptText="Filter jobs..." HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;"/>
        </HBox>

        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-dash-circle" iconSize="16" styleClass="icon-error"/>
            </graphic>
        </Button>
        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-plus-circle" iconSize="16" styleClass="icon-normal"/>
            </graphic>
        </Button>
        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-play-fill" iconSize="18" styleClass="icon-info"/>
            </graphic>
        </Button>

        <Separator orientation="VERTICAL"/>

        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-clock-history" iconSize="16" styleClass="icon-info"/>
            </graphic>
        </Button>
        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-brightness-high" iconSize="16" styleClass="icon-muted"/>
            </graphic>
        </Button>

        <Separator orientation="VERTICAL"/>

        <Button styleClass="icon-button" text="zz"
                style="-fx-text-fill: -fx-status-paused; -fx-font-family: 'Monospaced'; -fx-font-weight: bold;"/>
        <Button styleClass="icon-button">
            <graphic>
                <FontIcon iconLiteral="bi-slash-circle" iconSize="16" styleClass="icon-error"/>
            </graphic>
        </Button>

        <Separator orientation="VERTICAL"/>

        <Button>
            <graphic>
                <FontIcon iconLiteral="bi-arrow-clockwise" iconSize="16" styleClass="icon-normal"/>
            </graphic>
        </Button>
        <Button>
            <graphic>
                <FontIcon iconLiteral="bi-arrow-repeat" iconSize="16" styleClass="icon-info"/>
            </graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Pause Scheduler" styleClass="warning-button" style="-fx-font-weight: bold;"/>
    </HBox>

    <!-- Job table -->
    <TableView fx:id="jobTable" fixedCellSize="40" prefHeight="392">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nrCol" text="NR" prefWidth="50" maxWidth="60"/>
            <TableColumn fx:id="jobIdCol" text="JOB ID" prefWidth="160"/>
            <TableColumn fx:id="descriptionCol" text="DESCRIPTION" prefWidth="380"/>
            <TableColumn fx:id="stateCol" text="STATE" prefWidth="90" maxWidth="110"/>
            <TableColumn fx:id="runningCol" text="RUNNING" prefWidth="80" maxWidth="90"/>
            <TableColumn fx:id="intervalCol" text="INTERVAL" prefWidth="120" maxWidth="140"/>
            <TableColumn fx:id="doNothingCol" text="DO NOTHING" prefWidth="90" maxWidth="110"/>
            <TableColumn fx:id="durationCol" text="DURATION" prefWidth="90" maxWidth="110"/>
            <TableColumn fx:id="nextFireCol" text="NEXT FIRE" prefWidth="130"/>
        </columns>
    </TableView>

</VBox>
