<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.RadioButtonShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Radio Button" styleClass="showcase-page-title"/>
    <Label text="Radio buttons allow users to select one option from a set."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- States -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="States" styleClass="showcase-card-title"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <RadioButton fx:id="option1" text="Option 1" selected="true"/>
            <RadioButton fx:id="option2" text="Option 2"/>
            <RadioButton fx:id="option3" text="Option 3"/>
            <RadioButton text="Disabled" disable="true"/>
            <RadioButton text="Disabled Selected" selected="true" disable="true"/>
        </HBox>
    </VBox>

</VBox>
