<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.TabPaneShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="TabPane" styleClass="showcase-page-title"/>
    <Label text="Tab panes organize content into separate views, only one of which is visible at a time."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- Top tabs (default) -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Top Tabs (default)" styleClass="showcase-card-title"/>
        <TabPane tabClosingPolicy="UNAVAILABLE" minHeight="160" maxWidth="500">
            <Tab text="General">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="General settings content." wrapText="true"/>
                    <Button text="Apply"/>
                </VBox>
            </Tab>
            <Tab text="Appearance">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Appearance settings content." wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Advanced">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Advanced settings content." wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Disabled" disable="true">
                <VBox minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="This tab is disabled."/>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>

    <!-- Closable tabs -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Closable Tabs" styleClass="showcase-card-title"/>
        <TabPane fx:id="closableTabPane" tabClosingPolicy="ALL_TABS" minHeight="160" maxWidth="500"/>
    </VBox>

    <!-- Bottom tabs -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Bottom Tabs" styleClass="showcase-card-title"/>
        <TabPane side="BOTTOM" tabClosingPolicy="UNAVAILABLE" minHeight="160" maxWidth="500">
            <Tab text="Output">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Output panel content."/>
                </VBox>
            </Tab>
            <Tab text="Console">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Console panel content."/>
                </VBox>
            </Tab>
            <Tab text="Problems">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Problems panel content."/>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>

    <!-- Left tabs -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Left Tabs" styleClass="showcase-card-title"/>
        <TabPane side="LEFT" tabClosingPolicy="UNAVAILABLE" minHeight="200" maxWidth="500"
                 tabMinWidth="60" tabMaxWidth="80">
            <Tab text="Tab 1">
                <VBox spacing="8" minHeight="140">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Content for left-side tab 1." wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Tab 2">
                <VBox spacing="8" minHeight="140">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Content for left-side tab 2." wrapText="true"/>
                </VBox>
            </Tab>
            <Tab text="Tab 3">
                <VBox spacing="8" minHeight="140">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Content for left-side tab 3." wrapText="true"/>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>

    <!-- Floating style -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Floating Style" styleClass="showcase-card-title"/>
        <TabPane styleClass="floating" tabClosingPolicy="UNAVAILABLE" minHeight="160" maxWidth="500">
            <Tab text="Preview">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Preview content in floating style."/>
                </VBox>
            </Tab>
            <Tab text="Code">
                <VBox spacing="8" minHeight="100">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                    <Label text="Code content in floating style."/>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>

    <!-- Many tabs -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Many Tabs (overflow)" styleClass="showcase-card-title"/>
        <TabPane fx:id="manyTabsPane" tabClosingPolicy="UNAVAILABLE" minHeight="160" maxWidth="500"/>
    </VBox>

</VBox>
