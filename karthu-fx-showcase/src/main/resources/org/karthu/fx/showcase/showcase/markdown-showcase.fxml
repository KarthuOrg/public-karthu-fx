<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.MarkdownShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Markdown" styleClass="showcase-page-title"/>
    <Label text="MarkdownView renders a Markdown text with standard JavaFX nodes in the theme's look: headings, paragraphs, bold, italic, inline code, links, lists, block quotes, code blocks and thematic breaks. A link click goes to a handler the application sets; the view opens nothing itself. A code block's button copies its code; any text can be selected with the mouse as in a browser, across headings, paragraphs, lists, quotes and code blocks, a table taken whole, and copied with Ctrl+C; the context menu copies the selection or the whole Markdown source. A code block whose fence names a language the view knows (Java, JSON, YAML, SQL, XML and HTML, Bash, PowerShell, Markdown) shows its code in colours, keywords, strings, comments, types and more each in the colour of its category, and the Code colours card below the editor changes those colours at once through CSS. A table shows as a table whose columns share the width and whose rows all show, scrolling sideways only when its longest words do not fit: a click on a header sorts it in natural order, and its columns can be moved, resized, shown and hidden; its cells are selected as in a spreadsheet (click, drag, Shift or Ctrl and a click, Shift and the arrow keys, Shift+Space for whole rows, Ctrl+A, Select column in the context menu) and copied with Ctrl+C or the context menu as tab-separated text that pastes into a spreadsheet. Edit the text on the left; the view on the right follows every change and starts at the top. Drag the divider between them to make the view narrower or wider. The search field above the view, connected to it with one call, searches the document as you type: every match is marked in amber, the current one in a stronger amber, and the counter in the field says which match of how many. Enter goes to the next match and Shift+Enter to the previous one, the arrows in the field to the match above and the one below, Escape empties the field and ends the search, and the view scrolls to a match it does not show. The search finds the text of headings, paragraphs, lists, quotes, code blocks and tables, ignoring case and accents and taking several words as one piece. The choice beside the field sets the direction: Backward starts at the last match, and the next match is the one above. Insert a line at the top gives the view a new version of its text with updateMarkdown, a line more at the top, as an application does when it reloads a changed file: the view stays at the place you are reading and the images keep their pictures, where a change in the editor shows a new document from the top. The zoom bar on top of the view zooms the whole document from 50 to 200 %, as a web browser zooms a page, and the text wraps to the width of the view at every zoom: minus and plus go to the next of the presets 50, 75, 100, 125, 150 and 200 %, the percent field takes a typed value on Enter, the chevron (or Alt+Down in the field) opens the list of zoom levels, the slider sets any whole percent and Reset goes back to 100 %. Ctrl and the mouse wheel over the document, and Ctrl+Plus, Ctrl+Minus and Ctrl+0 while the view has the focus, zoom too, and the place you are reading stays in view. The zoom stays when the text changes. The Margins switch gives the view a left and a right margin of its own, which the two sliders change while you watch, in pixels at 100 % that the zoom scales; off, the theme's 14 pixels hold. A view narrower than both margins and 300 pixels of text shrinks them in their proportion, so the text keeps its 300 pixels: drag the divider to see it. The line at the top stays in place when a margin changes. The Zoom bar switch hides the bar, which also takes zooming from the reader; the line beside it reads the zoom as the application does. Images show as pictures, never larger than they were on the screen they were taken on: an image alone in its paragraph as a block, shrunk to the width of the text and the height of the view by the view's own area average, an image in a sentence in its line, one in a table as an icon and its alt text. The button over a block image, a click or Open image in the context menu open an image in a window at full size, which zooms, copies the image and saves its file. The sample's images lie in a folder beside the page, against which their relative addresses resolve. The Play animations switch plays animated GIFs in the document or shows their first frame, and the Images from the internet switch lets the view load images from http and https addresses, off at first, so the page sends no request by itself."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- Live editor -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Live editor" styleClass="showcase-card-title"/>
        <FlowPane hgap="16" vgap="8">
            <CheckBox fx:id="zoomBarSwitch" text="Zoom bar"/>
            <Label fx:id="zoomReadOut" styleClass="showcase-page-description"/>
            <!-- The view's imageAnimation and remoteImages, bound both ways by the controller. -->
            <CheckBox fx:id="animationSwitch" text="Play animations"/>
            <CheckBox fx:id="remoteImagesSwitch" text="Images from the internet"/>
            <!-- A new version of the shown text, as an application gives one after a reload of its file. -->
            <Button fx:id="insertLineButton" text="Insert a line at the top" onAction="#insertLineAtTop"/>
        </FlowPane>
        <!-- The view's margins: off, the theme's padding; on, the two sliders set them live, in pixels at 100 %. -->
        <FlowPane hgap="16" vgap="8">
            <CheckBox fx:id="marginsSwitch" text="Margins"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Left"/>
                <Slider fx:id="leftMarginSlider" min="0" max="400" value="80" prefWidth="160"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Right"/>
                <Slider fx:id="rightMarginSlider" min="0" max="400" value="40" prefWidth="160"/>
            </HBox>
            <Label fx:id="marginsReadOut" styleClass="showcase-page-description"/>
        </FlowPane>
        <!-- The view on the right, the divider lets the reader make it narrow. The showcase fits each page to the
             height of its scroll pane, which squeezed this row to make room for the cards below: its minimum height
             keeps the view large and lets the page scroll instead. -->
        <SplitPane fx:id="editorRow" minHeight="720" prefHeight="800" dividerPositions="0.5">
            <TextArea fx:id="sourceArea" prefWidth="420" wrapText="true"/>
            <!-- The application's own bar above the view, as an application builds one: the controller fills it and
                 adds the view under it. The bar asks for no width, so the divider narrows the view as far as the view
                 allows; the split pane clips what of the bar does not fit. -->
            <VBox fx:id="viewColumn" spacing="8">
                <HBox fx:id="searchBar" spacing="8" minWidth="0"/>
            </VBox>
        </SplitPane>
        <Label fx:id="linkLabel" text="Click a link in the view: the page shows the address its handler receives."
               styleClass="section-label" wrapText="true"/>
    </VBox>

    <!-- Code colours: the controller loads the text as a stylesheet of the view above at every change, through a data:
         address, so no file is written. -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Code colours" styleClass="showcase-card-title"/>
        <Label text="The CSS of the view above, applied at every change of the text: one rule with the 23 colour variables of coloured code, the nine base ones with their colours in the scheme in effect and the fourteen fine ones with the variable they fall back to. Change a colour and the view follows at once. A fine category follows its base until it is set itself. Add a rule of your own below it, such as .code-keyword { -fx-underline: true; }, which reaches keywords and annotations, or .code-annotation { -fx-underline: true; } for annotations alone. Bold and italic show only when the code font has those faces. Invalid CSS is skipped with a warning in the log, and the view keeps working. Defaults brings back this text and the theme's look."
               styleClass="showcase-page-description" wrapText="true"/>
        <!-- Its minimum height is its preferred one (-Infinity is USE_PREF_SIZE): the page, fitted to a short window,
             would squeeze it to one line, as it squeezed the editor row. -->
        <TextArea fx:id="codeColorsArea" prefRowCount="27" minHeight="-Infinity"/>
        <FlowPane hgap="16" vgap="8">
            <Button fx:id="codeColorsDefaults" text="Defaults" onAction="#restoreCodeColors"/>
        </FlowPane>
    </VBox>

</VBox>
