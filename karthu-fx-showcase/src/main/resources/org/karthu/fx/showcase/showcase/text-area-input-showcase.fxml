<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<!-- The text area input's page in the group Form inputs. Each card is filled by its own method of the controller. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.karthu.fx.showcase.controller.showcase.TextAreaInputShowcaseController"
      styleClass="showcase-page" spacing="16">

    <Label text="Text Area Input" styleClass="showcase-page-title"/>
    <Label text="TextAreaInput, several lines on the form collection's shell (see the Overview): a text area without a frame of its own whose lines wrap, four rows high unless the user resizes it. The {} icon (or Ctrl+Space) sits at the top right, where it sits in a single-line field, and the chip at the top left while bound. The grip at the bottom right makes the field taller, narrower or wider, never wider than its row; a double click on it goes back to the default size. The dragged size is a property the application may remember. Tab and Shift+Tab move to the next and the previous field, Ctrl+Tab inserts a tab."
           styleClass="showcase-page-description" wrapText="true"/>

    <!-- States side by side -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="States" styleClass="showcase-card-title"/>
        <Label text="Each field sits in a form row: its label above (hover it for the description) and the messages under the field. An error colours the border red, a warning amber, around text, {} and grip. A disabled field is greyed out, text, icons and grip. A read-only field shows its text to select and copy, without {}, and keeps its grip. The type's own states follow: no wrapping, more lines than rows, two rows, and a size the user dragged to."
               styleClass="showcase-page-description" wrapText="true"/>
        <GridPane fx:id="statesGrid" hgap="12" vgap="8"/>
    </VBox>

    <!-- Try it out -->
    <VBox styleClass="showcase-card" spacing="12">
        <Label text="Try it out" styleClass="showcase-card-title"/>
        <Label text="Switch the field's states on and off. Drag the grip at the bottom right: the field gets taller or lower, but never lower than two rows, and narrower or wider, but never wider than its row, which it fills at its default size; a double click on the grip goes back to the default size. Remember size keeps the dragged size, Restore size sets it again, as an application that stores the size would. Bindable offers three sample variables: bind with the {} icon or Ctrl+Space, unbind with the chip's ×, Backspace or Remove binding, and the text comes back."
               styleClass="showcase-page-description" wrapText="true"/>
        <FlowPane fx:id="tryOutSwitches" hgap="16" vgap="8"/>
        <VBox fx:id="tryOutContainer" spacing="8"/>
    </VBox>

</VBox>
